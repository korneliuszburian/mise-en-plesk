[Unit]
Description=mise-en-plesk read-only Plesk and WordPress scan
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Create the service account before installing this unit:
# useradd --system --home-dir /var/lib/mise-en-plesk --create-home --shell /usr/sbin/nologin mise-en-plesk
# Copy this file to /etc/systemd/system/ and replace /opt/mise-en-plesk
# with the absolute checkout path used by that account.
User=mise-en-plesk
Group=mise-en-plesk
WorkingDirectory=/opt/mise-en-plesk
Environment=MISE_PLESK_SCHEDULED_TARGET=all
Environment=MISE_PLESK_SCAN_CHUNK_SIZE=20
Environment=MISE_PLESK_INVENTORY=/var/lib/mise-en-plesk/inventory.json
Environment=MISE_PLESK_CONFIG=/var/lib/mise-en-plesk/config.mise-en-plesk.json
Environment=MISE_PLESK_REPORTS=/var/lib/mise-en-plesk/reports
Environment=MISE_PLESK_SCHEDULE_LOG_DIR=/var/lib/mise-en-plesk/logs
Environment=MISE_PLESK_SCHEDULE_LOCK_FILE=/var/lib/mise-en-plesk/scan.lock
Environment=MISE_PLESK_SCAN_CURSOR=/var/lib/mise-en-plesk/scan-cursor.json
Environment=MISE_PLESK_FINDINGS=/var/lib/mise-en-plesk/findings.json
Environment=MISE_PLESK_SCAN_CYCLES=/var/lib/mise-en-plesk/scan-cycles.json
Environment=MISE_PLESK_NOTIFICATION_OUTBOX=/var/lib/mise-en-plesk/notification-outbox.json
Environment=MISE_PLESK_NOTIFICATION_HISTORY=/var/lib/mise-en-plesk/notification-history.json
Environment=MISE_PLESK_HEARTBEAT=/var/lib/mise-en-plesk/heartbeat.json
Environment=MISE_PLESK_VULN_CACHE=/var/lib/mise-en-plesk/vulnerabilities.json
Environment=HOME=/var/lib/mise-en-plesk
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Optional non-secret routing configuration; Hermes credentials stay in the
# service account's HOME and are managed by Hermes itself.
EnvironmentFile=-/etc/mise-en-plesk/mise-en-plesk.env
# Install pnpm system-wide at this path, or change this explicit runner path.
Environment=MISE_PLESK_RUNNER_BIN=/usr/local/bin/pnpm
LoadCredentialEncrypted=BW_SESSION:/etc/mise-en-plesk/bw-session.cred
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/mise-en-plesk
ExecStartPre=/usr/bin/test -x /usr/local/bin/pnpm
ExecStart=/usr/bin/bash /opt/mise-en-plesk/scripts/run-scheduled-scan-systemd.sh
